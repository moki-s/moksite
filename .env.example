# moksite environment variables (PRD §7.5)
# Copy to .env.local for development. NEVER commit real secrets — .env.local is git-ignored.

# Resend — transactional email for the contact form (Phase 6). Secret: set in Vercel.
RESEND_API_KEY=
# Inbox that contact-form signals are delivered to.
CONTACT_TO_EMAIL=

# Canonical site URL — used for OG images, sitemap, and canonical links.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Plausible analytics domain. Omit locally — analytics no-ops when absent.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
